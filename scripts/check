#!/usr/bin/env bash
# Every check plumbline runs on itself. CI runs this, and so does the pre-push hook.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO" || exit 1

status=0

echo "== shellcheck"
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck install.sh hooks/session-start.sh scripts/check scripts/check-commit.sh \
    tests/*.test.sh .githooks/* || status=1
elif [ -n "${CI:-}" ]; then
  echo "shellcheck is not installed" >&2
  status=1
else
  echo "shellcheck is not installed here, so only CI runs it"
fi

for test in tests/*.test.sh; do
  echo "== $test"
  bash "$test" || status=1
done

exit "$status"
